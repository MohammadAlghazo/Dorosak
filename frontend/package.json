{
  "name": "dorosak-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "build:development": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "icons:generate": "node tools/generate-icons.mjs",
    "verify:budgets": "node tools/verify-budgets.mjs",
    "verify:pwa": "node tools/verify-pwa.mjs",
    "serve:ssr": "node dist/dorosak-web/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.x",
    "npm": "11.17.x"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/platform-server": "21.2.19",
    "@angular/router": "21.2.19",
    "@angular/service-worker": "21.2.19",
    "@angular/ssr": "21.2.20",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "bootstrap": "5.3.8",
    "express": "5.2.1",
    "hash-wasm": "4.12.0",
    "http-proxy-middleware": "4.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.20",
    "@angular/cli": "21.2.20",
    "@angular/compiler-cli": "21.2.19",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "21.4.0",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "undici": "7.29.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
