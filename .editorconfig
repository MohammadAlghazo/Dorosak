root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = false:silent

[backend/src/**/Persistence/Migrations/*.cs]
generated_code = true

[backend/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.{ts,tsx,js,mjs,cjs,json,jsonc,html,css,scss,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
