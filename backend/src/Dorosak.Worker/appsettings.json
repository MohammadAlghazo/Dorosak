{
  "App": {
    "PublicUrl": "http://localhost:4200"
  },
  "Email": {
    "SmtpHost": "127.0.0.1",
    "SmtpPort": 1026,
    "UseTls": false,
    "FromAddress": "noreply@dorosak.test",
    "FromName": "Dorosak"
  },
  "OpenTelemetry": {
    "Endpoint": ""
  },
  "Media": {
    "Environment": "development",
    "Storage": {
      "Enabled": false,
      "Endpoint": "http://127.0.0.1:9100",
      "PublicEndpoint": "http://127.0.0.1:9100",
      "Bucket": "dorosak-media",
      "Region": "us-east-1",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true,
      "UploadUrlMinutes": 10,
      "DownloadUrlMinutes": 5
      ,"CreateBucketIfMissing": false
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  }
}
