{
  "AllowedHosts": "localhost;127.0.0.1",
  "App": {
    "PublicUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "CorrelationId": {
    "TrustedClientAddresses": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Identity": {
    "AccessTokenMinutes": 10,
    "RefreshIdleDays": 14,
    "RefreshAbsoluteDays": 30,
    "RefreshRaceWindowSeconds": 10,
    "RecentAuthenticationMinutes": 15,
    "MfaChallengeMinutes": 5,
    "MfaMaximumAttempts": 5,
    "RecoveryCodeCount": 10,
    "PasswordHashIterations": 210000,
    "RefreshCookieName": "__Secure-dorosak-refresh"
  },
  "Jwt": {
    "Issuer": "Dorosak",
    "Audience": "Dorosak.Web",
    "KeyId": "development"
  },
  "SecurityRateLimits": {
    "KeyPrefix": "dorosak:development:v1:security-rate-limit",
    "PartitionSalt": "dorosak-development-rate-limit-partition"
  },
  "PasswordBreachCheck": {
    "Enabled": false,
    "BaseUrl": "https://api.pwnedpasswords.com/"
  },
  "Catalog": {
    "Cursors": {
      "SigningKey": "Dorosak-development-cursor-signing-key-only",
      "Environment": "development",
      "SchemaVersion": "phase6"
    }
  },
  "OpenTelemetry": {
    "Endpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  }
}
