{
  "Media": {
    "Environment": "development",
    "WorkerConcurrency": 2,
    "WorkerMaxAttempts": 5,
    "WorkerLockDuration": "00:05:00",
    "Storage": {
      "Enabled": true,
      "Endpoint": "http://127.0.0.1:9100",
      "PublicEndpoint": "http://127.0.0.1:9100",
      "Bucket": "dorosak-media",
      "Region": "us-east-1",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "ForcePathStyle": true,
      "UploadUrlMinutes": 10,
      "DownloadUrlMinutes": 5
    },
    "ClamAV": {
      "Host": "127.0.0.1",
      "Port": 3311,
      "ChunkBytes": 1048576
    }
  },
  "OpenTelemetry": {
    "Endpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  }
}
